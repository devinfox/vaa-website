# --- CRM lead intake (auto-enrolls leads into email funnels) ---
# e.g. https://www.voicealchemyacademy.app/api/leads/inbound
CRM_LEADS_URL=
# Must match LEAD_INTAKE_SECRET in the CRM's Vercel env
CRM_LEADS_SECRET=

# --- Lead capture (landing page email forms) ---
# Optional. When set, every lead and mentorship application is also POSTed here as JSON.
LEAD_WEBHOOK_URL=

# --- 1:1 mentorship applications (/mentorship form) ---
# Recipient inbox. Defaults to voicealchemyacademy@gmail.com (lib/site.ts).
MENTORSHIP_TO_EMAIL=voicealchemyacademy@gmail.com
# Verified sender on your email provider. Defaults to hello@voicealchemyacademy.com.
MENTORSHIP_FROM_EMAIL=hello@voicealchemyacademy.com
# Provide ONE of these. The CRM already has a SendGrid key you can reuse.
SENDGRID_API_KEY=
RESEND_API_KEY=
